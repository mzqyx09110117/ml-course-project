# 统一换行与文本属性
* text=auto eol=lf

# 代码
*.py      text diff=python
*.sh      text eol=lf
*.md      text
*.txt     text
*.yml     text
*.yaml    text

# 二进制（不做换行转换，diff 只显示大小变化）
*.png     binary
*.jpg     binary
*.jpeg    binary
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.pptx    binary
*.zip     binary

# Notebook：按 Markdown 归并，减少无意义冲突
*.ipynb   text eol=lf diff=jupyternotebook merge=jupyternotebook
