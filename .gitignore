# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.python-version

# ---------- 数据（体积大 / 可复现，不入库）----------
data/raw/
data/processed/
data/**/*.csv
*.zip
*.tar.gz

# ---------- 训练产物 ----------
models/
# metrics：指标 json 是可复现性的关键证据，入库；大体积中间结果不入库
results/metrics/*
!results/metrics/*.json
!results/metrics/.gitkeep
logs/
*.log
runs/

# ---------- Notebook 相关 ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---------- 构建 / 排版临时文件 ----------
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz
report/_build/
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp
*.bak

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地私有配置（不入库）----------
*.local.*
.env

# 运行时生成的中文字体（由 scripts/run_experiments.py 自动提取）
assets/fonts/*
