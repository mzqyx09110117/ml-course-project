#!/usr/bin/env bash
# 提交前守卫：身份校验 + 敏感字样扫描 + 体积校验
# 启用方式（仓库根目录执行一次）：
#   git config core.hooksPath .githooks
set -euo pipefail

NAME_WANT="${AUTHOR_NAME:-mzqyx09110117}"
EMAIL_WANT="${AUTHOR_EMAIL:-20245627@stu.neu.edu.cn}"

fail() { echo "✗ [pre-commit] $*" >&2; exit 1; }

# ---------- 1) 作者身份 ----------
cur_name="$(git config user.name || true)"
cur_email="$(git config user.email || true)"
[ "$cur_name" = "$NAME_WANT" ]   || fail "git user.name 应为 '$NAME_WANT'，当前为 '$cur_name'"
[ "$cur_email" = "$EMAIL_WANT" ] || fail "git user.email 应为 '$EMAIL_WANT'，当前为 '$cur_email'"

if [ -n "${GIT_AUTHOR_EMAIL:-}" ] && [ "$GIT_AUTHOR_EMAIL" != "$EMAIL_WANT" ]; then
  fail "GIT_AUTHOR_EMAIL='$GIT_AUTHOR_EMAIL' 不是指定邮箱，检查是否继承了他人的环境变量"
fi
if [ -n "${GIT_COMMITTER_EMAIL:-}" ] && [ "$GIT_COMMITTER_EMAIL" != "$EMAIL_WANT" ]; then
  fail "GIT_COMMITTER_EMAIL='$GIT_COMMITTER_EMAIL' 不是指定邮箱"
fi

# ---------- 2) 敏感字样 ----------
# 通用规则（写死在仓库里，可公开）；具体工具名从本地文件读取，不随仓库分发。
PATTERN='co-authored-by|generated[ -]with|generated[ -]by|assisted[ -]by|powered[ -]by|ai[ -]generated|ai[ -]assisted|code assistant'

# 扫描范围：暂存的新增/修改文本文件；跳过 .githooks 自身（其中含规则字符串）
staged_text_files() {
  git diff --cached --name-only --diff-filter=ACMR | while read -r f; do
    [ -z "$f" ] && continue
    case "$f" in .githooks/*) continue;; esac
    [ -f "$f" ] || continue
    # 跳过二进制（含 NUL 字节）
    grep -Iq . "$f" 2>/dev/null || continue
    echo "$f"
  done
}

hits="$(staged_text_files | while read -r f; do
          git diff --cached -U0 -- "$f" | grep '^+' | grep -inE "$PATTERN" \
            | sed "s|^|$f: |" || true
        done)"

LOCAL_TERMS="${BLOCKED_TERMS:-$(dirname "$0")/blocked_terms.local.txt}"
if [ -f "$LOCAL_TERMS" ]; then
  while IFS= read -r term; do
    [ -z "$term" ] && continue
    case "$term" in \#*) continue;; esac
    more="$(staged_text_files | while read -r f; do
              git diff --cached -U0 -- "$f" | grep '^+' | grep -inF "$term" \
                | sed "s|^|$f: |" || true
            done)"
    [ -n "$more" ] && hits="${hits}${hits:+$'\n'}${more}"
  done < "$LOCAL_TERMS"
fi

if [ -n "$hits" ]; then
  echo "$hits" >&2
  fail "暂存内容命中敏感字样，请修改后再提交（规则见 .githooks/pre-commit）"
fi

# ---------- 3) 体积与数据文件 ----------
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    data/raw/*|data/processed/*|data/interim/*)
      fail "数据文件不应入库：$f（应通过 scripts/download_data.py 获取）";;
  esac
  if [ -f "$f" ]; then
    sz=$(wc -c <"$f")
    if [ "$sz" -gt 5242880 ]; then
      fail "文件超过 5 MB：$f（$((sz/1024/1024)) MB），请移出仓库或使用外部存储"
    fi
  fi
done <<< "$(git diff --cached --name-only --diff-filter=ACMR)"

# ---------- 4) Notebook 输出 ----------
while IFS= read -r f; do
  case "$f" in
    *.ipynb)
      if [ -f "$f" ] && grep -q '"outputs": \[' -A2 "$f" 2>/dev/null; then
        echo "! [pre-commit] 提示：$f 含单元格输出，建议清空后再提交（减小体积、避免泄露路径）" >&2
      fi;;
  esac
done <<< "$(git diff --cached --name-only --diff-filter=ACMR)"

echo "✓ [pre-commit] 校验通过"
