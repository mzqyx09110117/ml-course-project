#!/usr/bin/env bash
# 提交信息守卫：禁止署名尾注与任何生成器痕迹
# 启用方式（仓库根目录执行一次）：
#   git config core.hooksPath .githooks
set -euo pipefail

MSG_FILE="$1"
PATTERN='co-authored-by|generated[ -]with|generated[ -]by|assisted[ -]by|powered[ -]by|ai[ -]generated|ai[ -]assisted|code assistant'

if grep -inE "$PATTERN" "$MSG_FILE" >/dev/null 2>&1; then
  echo "✗ [commit-msg] 提交信息含禁止的署名/生成声明：" >&2
  grep -inE "$PATTERN" "$MSG_FILE" >&2 || true
  echo "  只写做了什么，例如：feat: 增加 5 折交叉验证" >&2
  exit 1
fi

LOCAL_TERMS="${BLOCKED_TERMS:-$(dirname "$0")/blocked_terms.local.txt}"
if [ -f "$LOCAL_TERMS" ]; then
  while IFS= read -r term; do
    [ -z "$term" ] && continue
    case "$term" in \#*) continue;; esac
    if grep -inF "$term" "$MSG_FILE" >/dev/null 2>&1; then
      echo "✗ [commit-msg] 提交信息命中本地敏感词：$term" >&2
      exit 1
    fi
  done < "$LOCAL_TERMS"
fi

# 空提交信息拦截
if ! grep -qE '[^[:space:]]' "$MSG_FILE"; then
  echo "✗ [commit-msg] 提交信息不能为空" >&2
  exit 1
fi

echo "✓ [commit-msg] 校验通过"
